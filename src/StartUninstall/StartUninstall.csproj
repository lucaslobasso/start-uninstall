<Project Sdk="Microsoft.NET.Sdk">
  <!-- Native AOT, no window, raw COM UI Automation: no WinForms/WPF, no interop assembly, no runtime to load. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>StartUninstall</AssemblyName>
    <RootNamespace>StartUninstall</RootNamespace>
    <AssemblyTitle>Start Uninstall</AssemblyTitle>
    <Product>Start Uninstall</Product>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <StackTraceSupport>false</StackTraceSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <DebugType>none</DebugType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- small, quiet GC: no background GC thread, keep the heap compact -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\StartUninstall.Core\StartUninstall.Core.csproj" />
  </ItemGroup>
</Project>
